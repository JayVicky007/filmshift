}

/* ==========================================================================
   🎯 TIPTAP EXTENSION & RICH TEXT CORE EDITOR OVERRIDES
   ========================================================================== */

/* Focused layout tracking rule to ensure outline doesn't overlap container shapes */
.tiptap:focus {
