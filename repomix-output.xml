  --text-muted: #5C6470;
  --accent: #FFC107;
  --trending-text: #8A5A00;
}

[data-theme='dark'] {
  --background: #10161E;
  --foreground: #E7ECF2;
  --surface: #1A2430;
  --text-muted: #A8B1BC;
  --accent: #FFC107;
  --trending-text: #FFC107;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-surface: var(--surface);
  --color-text-muted: var(--text-muted);
  --color-accent: var(--accent);
  --color-trending-text: var(--trending-text);
}

html {
  background-color: var(--background);
